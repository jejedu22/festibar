PORT=3001
SQLITE_FILE=./bar.db

# --- Sécurité ---
# Secret de signature des sessions (générer avec : openssl rand -hex 32)
JWT_SECRET=change-me-in-prod
# Empreinte bcrypt du mot de passe administrateur (générer avec : node scripts/hash-password.js "motdepasse")
# OBLIGATOIRE : apostrophes autour de l'empreinte (pas de guillemets). Sans elles, Docker Compose
# prend les "$..." pour des variables et tronque l'empreinte : la connexion admin échoue.
# Exemple : ADMIN_PASSWORD_HASH='$2b$12$...'
ADMIN_PASSWORD_HASH=
# Durée des sessions : administrateur / organisations (gestionnaires et serveurs)
ADMIN_TOKEN_TTL=12h
ORG_TOKEN_TTL=24h
# Délai pendant lequel un serveur peut annuler une commande qu'il a saisie (minutes)
STAFF_CANCEL_MINUTES=15
# Vérifications de mot de passe (bcrypt) en parallèle, et exports Excel simultanés : protègent le CPU et la mémoire
BCRYPT_CONCURRENCY=2
EXPORT_CONCURRENCY=2
# Derrière un reverse proxy (Traefik, nginx…) : 1 ; HSTS seulement si servi en HTTPS (déjà définis dans docker-compose.yml)
TRUST_PROXY=
ENABLE_HSTS=false
# Origines autorisées à appeler l'API depuis un autre domaine (séparées par des virgules, vide = aucune)
ALLOWED_ORIGINS=

# --- Événement ---
# Fuseau horaire et heure de début de la « journée de service » (6 → les ventes jusqu'à 6h comptent pour la veille)
APP_TIMEZONE=Europe/Paris
SERVICE_DAY_START_HOUR=6

# --- Données ---
# Sauvegarde automatique de la base (minutes, 0 = désactivée) et nombre de sauvegardes conservées
BACKUP_INTERVAL_MINUTES=60
BACKUP_KEEP=48
# Durée de conservation des demandes de contact (RGPD), en jours
CONTACT_RETENTION_DAYS=365

# --- Email (formulaire « Demander un accès ») ---
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Adresse d'expédition (obligatoire si SMTP_USER n'est pas une adresse email, ex. Brevo/SendGrid)
SMTP_FROM=
# Tester la configuration : node scripts/test-mail.js (Docker : docker compose exec festibar node scripts/test-mail.js)

# --- Mentions légales (affichées sur /mentions-legales, /confidentialite, /cgu) ---
LEGAL_EDITOR_NAME=
# ex. « Association loi 1901 »
LEGAL_EDITOR_STATUS=
LEGAL_EDITOR_ADDRESS=
# ex. « RNA W123456789 » ou « SIREN 123 456 789 »
LEGAL_EDITOR_REGISTRATION=
LEGAL_EDITOR_EMAIL=
LEGAL_EDITOR_PHONE=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_PRIVACY_EMAIL=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_PHONE=
