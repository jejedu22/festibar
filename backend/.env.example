PORT=3001
# Secret de signature des sessions admin (générer avec : openssl rand -hex 32)
JWT_SECRET=change-me-in-prod
# Durée de validité d'une session admin
ADMIN_TOKEN_TTL=12h
# Empreinte bcrypt du mot de passe admin (générer avec : node scripts/hash-password.js "motdepasse")
# Garder les apostrophes autour de l'empreinte : elle contient des "$"
# Exemple : ADMIN_PASSWORD_HASH='$2b$12$...'
ADMIN_PASSWORD_HASH=
ALLOWED_ORIGINS=http://localhost:8001
SQLITE_FILE=./bar.db
